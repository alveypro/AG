<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🛡️ MAO 万无一失安全区块链游戏 - v9.0 ULTRA-SECURE</title>
    <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; font-family: Inter, sans-serif; }
        .glass { background: rgba(255,255,255,0.15); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.3); }
        .wheel { width: 300px; height: 300px; border-radius: 50%; background: conic-gradient(from 0deg, #ef4444 0deg 180deg, #10b981 180deg 360deg); transition: transform 4s ease; position: relative; }
        .spinning { animation: spin 4s ease; }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(1800deg); } }
        .token-btn { padding: 12px 24px; border-radius: 12px; cursor: pointer; transition: all 0.3s; }
        .token-btn.active { background: linear-gradient(135deg, #f59e0b, #fbbf24); color: black; }
        .game-btn { background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 16px 32px; border-radius: 16px; font-weight: bold; cursor: pointer; transition: all 0.3s; }
        .security-btn { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; padding: 12px 24px; border-radius: 12px; font-weight: bold; cursor: pointer; transition: all 0.3s; }
        .loading { width: 20px; height: 20px; border: 2px solid #fff; border-top: 2px solid #f59e0b; border-radius: 50%; animation: rotate 1s linear infinite; }
        @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .security-alert { background: linear-gradient(135deg, #ef4444, #dc2626); border: 2px solid #fca5a5; }
        .security-success { background: linear-gradient(135deg, #10b981, #059669); border: 2px solid #86efac; }
        .security-warning { background: linear-gradient(135deg, #f59e0b, #d97706); border: 2px solid #fde047; }
    </style>
</head>
<body class="text-white">
    <div class="container mx-auto p-8">
        <h1 class="text-4xl font-bold text-center mb-8">🛡️ MAO 万无一失安全区块链游戏</h1>
        
        <!-- Security Status Bar -->
        <div class="glass rounded-2xl p-4 mb-6">
            <div class="flex items-center justify-center">
                <span id="securityStatus" class="text-sm">🛡️ 初始化多层安全防护系统...</span>
            </div>
        </div>

        <!-- Network Status Bar -->
        <div class="glass rounded-2xl p-4 mb-6">
            <div class="flex items-center justify-center">
                <span id="networkStatus" class="text-sm">🔗 初始化多节点安全区块链系统...</span>
            </div>
        </div>

        <!-- Security Configuration Panel -->
        <div class="glass rounded-2xl p-6 mb-8">
            <h3 class="text-xl font-semibold mb-4">🔒 安全配置面板</h3>
            <div class="grid grid-cols-2 gap-4">
                <div class="glass rounded-xl p-4">
                    <div class="text-center">
                        <div class="text-2xl mb-2">🔐</div>
                        <div class="text-yellow-400 text-lg font-bold" id="multisigStatus">未配置</div>
                        <div class="text-sm">多重签名钱包</div>
                    </div>
                </div>
                <div class="glass rounded-xl p-4">
                    <div class="text-center">
                        <div class="text-2xl mb-2">⏰</div>
                        <div class="text-green-400 text-lg font-bold" id="timelockStatus">未配置</div>
                        <div class="text-sm">时间锁保护</div>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-3 gap-4 mt-4">
                <div class="glass rounded-xl p-4">
                    <div class="text-center">
                        <div class="text-2xl mb-2">💰</div>
                        <div class="text-blue-400 text-lg font-bold" id="limitStatus">未配置</div>
                        <div class="text-sm">限额控制</div>
                    </div>
                </div>
                <div class="glass rounded-xl p-4">
                    <div class="text-center">
                        <div class="text-2xl mb-2">📊</div>
                        <div class="text-purple-400 text-lg font-bold" id="monitorStatus">未配置</div>
                        <div class="text-sm">实时监控</div>
                    </div>
                </div>
                <div class="glass rounded-xl p-4">
                    <div class="text-center">
                        <div class="text-2xl mb-2">🛡️</div>
                        <div class="text-red-400 text-lg font-bold" id="overallSecurity">低</div>
                        <div class="text-sm">整体安全等级</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Wallet Section -->
        <div class="glass rounded-2xl p-6 mb-8">
            <div id="walletDisconnected">
                <button id="connectBtn" class="game-btn mx-auto block">连接 MetaMask 钱包</button>
            </div>
            <div id="walletConnected" class="hidden">
                <div class="text-center mb-4">
                    <span class="text-green-400">安全钱包已连接:</span>
                    <span id="walletAddress" class="font-mono"></span>
                </div>
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="glass rounded-xl p-4 text-center">
                        <div class="text-2xl mb-2">🐱</div>
                        <div class="text-yellow-400 text-2xl font-bold" id="maoBalance">0</div>
                        <div class="text-sm">MAO</div>
                    </div>
                    <div class="glass rounded-xl p-4 text-center">
                        <div class="text-2xl mb-2">🥧</div>
                        <div class="text-green-400 text-2xl font-bold" id="piBalance">0</div>
                        <div class="text-sm">PI</div>
                    </div>
                </div>
                
                <!-- Token Selection -->
                <div class="flex justify-center mb-6">
                    <div class="glass rounded-xl p-2 flex gap-2">
                        <button id="selectMao" class="token-btn active">🐱 MAO (100)</button>
                        <button id="selectPi" class="token-btn">🥧 PI (1000)</button>
                    </div>
                </div>
                
                <!-- Wheel -->
                <div class="flex justify-center mb-6">
                    <div class="relative">
                        <div class="wheel" id="wheel">
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center">
                                    <span class="text-2xl">🎯</span>
                                </div>
                            </div>
                        </div>
                        <div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-2">
                            <div class="w-0 h-0 border-l-4 border-r-4 border-b-8 border-transparent border-b-yellow-400"></div>
                        </div>
                    </div>
                </div>
                
                <!-- Game Button -->
                <div class="text-center">
                    <button id="spinBtn" class="game-btn">🛡️ 万无一失安全转盘</button>
                    <div id="gameStatus" class="mt-4 text-sm">🛡️ 多层安全防护系统已就绪</div>
                </div>
            </div>
        </div>

        <!-- Security Controls -->
        <div class="glass rounded-2xl p-6 mb-8">
            <h3 class="text-xl font-semibold mb-4">🔧 安全控制中心</h3>
            <div class="grid grid-cols-2 gap-4">
                <button id="initMultisigBtn" class="security-btn">🔐 初始化多重签名</button>
                <button id="setupTimelockBtn" class="security-btn">⏰ 配置时间锁</button>
                <button id="setLimitsBtn" class="security-btn">💰 设置限额控制</button>
                <button id="enableMonitorBtn" class="security-btn">📊 启用实时监控</button>
            </div>
        </div>
        
        <!-- Stats -->
        <div class="glass rounded-2xl p-6">
            <h3 class="text-xl font-semibold mb-4">📊 安全区块链统计</h3>
            <div class="grid grid-cols-4 gap-4">
                <div class="text-center">
                    <div class="text-2xl font-bold text-blue-400" id="totalGames">0</div>
                    <div class="text-sm">总局数</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-green-400" id="winCount">0</div>
                    <div class="text-sm">胜利数</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-yellow-400" id="winRate">0%</div>
                    <div class="text-sm">胜率</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-purple-400" id="totalReward">0</div>
                    <div class="text-sm">总奖励</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Result Modal -->
    <div id="resultModal" class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center hidden">
        <div class="glass rounded-2xl p-8 max-w-md text-center">
            <div id="resultIcon" class="text-6xl mb-4"></div>
            <h3 id="resultTitle" class="text-2xl font-bold mb-2"></h3>
            <p id="resultMessage" class="mb-4"></p>
            <div id="resultReward" class="text-3xl font-bold text-yellow-400 mb-6"></div>
            <div id="txHash" class="text-xs text-blue-300 mb-4 font-mono break-all"></div>
            <button id="closeModal" class="game-btn">继续安全游戏</button>
        </div>
    </div>

    <!-- Security Alert Modal -->
    <div id="securityModal" class="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center hidden">
        <div class="glass rounded-2xl p-8 max-w-lg text-center">
            <div id="securityIcon" class="text-6xl mb-4">🛡️</div>
            <h3 id="securityTitle" class="text-2xl font-bold mb-2">安全系统</h3>
            <p id="securityMessage" class="mb-4"></p>
            <div id="securityDetails" class="text-sm text-gray-300 mb-6"></div>
            <button id="closeSecurityModal" class="game-btn">确认</button>
        </div>
    </div>

    <script>
        // 🛡️ 万无一失安全区块链游戏引擎 v9.0 ULTRA-SECURE
        class UltraSecureBlockchainGameEngine {
            constructor() {
                this.state = {
                    wallet: { connected: false, address: null, provider: null, signer: null },
                    selectedToken: 'MAO',
                    isPlaying: false,
                    stats: { totalGames: 0, winCount: 0, totalReward: 0 },
                    contracts: { mao: null, pi: null, wheelGame: null, multisig: null, timelock: null },
                    currentRpcIndex: 0,
                    security: {
                        multisigEnabled: false,
                        timelockEnabled: false,
                        limitsEnabled: false,
                        monitoringEnabled: false,
                        securityLevel: 'LOW'
                    }
                };
                
                // 🔐 安全地址配置 - 使用环境变量或配置文件
                this.secureAddresses = {
                    // 🚨 注意：这些地址应该从安全的环境变量加载，而不是硬编码
                    MAO_TOKEN: this.getSecureAddress('MAO_TOKEN', "0x22f49bcb3dad370a9268ba3fca33cb037ca3d022"),
                    PI_TOKEN: this.getSecureAddress('PI_TOKEN', "0xfd4680e25e05b3435c7f698668d1ce80d2a9f444"),
                    WHEEL_GAME: this.getSecureAddress('WHEEL_GAME', "0x621DF9e0DE6b4e7EDC5Dc22Cd7c0F883c3F56966"),
                    
                    // 🛡️ 新的多重签名安全地址（需要部署）
                    MULTISIG_WALLET: this.getSecureAddress('MULTISIG_WALLET', "0x0000000000000000000000000000000000000000"),
                    TIMELOCK_CONTROLLER: this.getSecureAddress('TIMELOCK_CONTROLLER', "0x0000000000000000000000000000000000000000"),
                    
                    // ❌ 绝对禁止使用被盗地址
                    BLACKLISTED: [
                        "0xE15881Fc413c6cd47a512C24608F94Fa2896b374", // 已确认被盗
                        // 添加其他已知被盗地址
                    ]
                };

                // 🔧 多RPC节点配置 - 增强网络安全性
                this.rpcNodes = [
                    'https://elves-core2.alvey.io', // 优先使用core2
                    'https://elves-core3.alvey.io', // 备用core3
                    'https://elves-core1.alvey.io'  // core1作为最后备用
                ];

                this.networkConfig = {
                    chainId: '0xED5', // 3797
                    chainName: 'AlveyChain Mainnet',
                    nativeCurrency: { name: 'ALV', symbol: 'ALV', decimals: 18 },
                    rpcUrls: this.rpcNodes,
                    blockExplorerUrls: ['https://alveyscan.com']
                };

                // 🔐 安全限制配置
                this.securityLimits = {
                    maxSingleTransaction: ethers.utils.parseEther('10000'), // 单次最大10,000代币
                    maxDailyLimit: ethers.utils.parseEther('50000'), // 每日最大50,000代币
                    maxWeeklyLimit: ethers.utils.parseEther('200000'), // 每周最大200,000代币
                    timelockDelay: 24 * 60 * 60, // 24小时延迟
                    requiredConfirmations: 6, // 需要6个区块确认
                    maxGasPrice: ethers.utils.parseUnits('100', 'gwei') // 最大Gas价格
                };

                this.tokenABI = [
                    "function balanceOf(address owner) external view returns (uint256)",
                    "function approve(address spender, uint256 amount) external returns (bool)",
                    "function allowance(address owner, address spender) external view returns (uint256)",
                    "function symbol() external view returns (string)"
                ];

                this.gameABI = [
                    "function playMAOGame() external",
                    "function playPIGame() external",
                    "function getPlayerHistory(address player) external view returns (tuple(address player, uint8 tokenType, uint256 betAmount, uint256 rewardAmount, uint8 rewardLevel, uint256 timestamp, uint256 randomSeed, bool wasProtected)[])",
                    "function getGameStats(uint8 tokenType) external view returns (tuple(uint256 totalGames, uint256 totalWins, uint256 totalBets, uint256 totalRewards, uint256 protectedGames))",
                    "event GamePlayed(address indexed player, uint8 tokenType, uint256 betAmount, uint256 rewardAmount, uint8 rewardLevel, uint256 randomSeed, bool wasProtected)"
                ];

                // 🛡️ 多重签名钱包ABI
                this.multisigABI = [
                    "function getOwners() external view returns (address[])",
                    "function getThreshold() external view returns (uint256)",
                    "function isOwner(address owner) external view returns (bool)",
                    "function getTransactionCount() external view returns (uint256)"
                ];

                // ⏰ 时间锁控制器ABI
                this.timelockABI = [
                    "function getMinDelay() external view returns (uint256)",
                    "function isOperation(bytes32 id) external view returns (bool)",
                    "function isOperationPending(bytes32 id) external view returns (bool)",
                    "function isOperationReady(bytes32 id) external view returns (bool)",
                    "function isOperationDone(bytes32 id) external view returns (bool)"
                ];

                this.init();
            }

            // 🔐 安全地址获取方法
            getSecureAddress(key, defaultValue) {
                // 在生产环境中，这应该从安全的环境变量或配置服务获取
                // process.env[key] || localStorage.getItem(key) || defaultValue
                return defaultValue;
            }

            // 🚨 地址安全检查
            isAddressSafe(address) {
                if (!address) return false;
                if (this.secureAddresses.BLACKLISTED.includes(address)) {
                    this.showSecurityAlert('❌ 危险地址检测', `地址 ${address} 已被列入黑名单，禁止使用！`, 'error');
                    return false;
                }
                return true;
            }

            formatAddress(addr) {
                return addr ? `${addr.slice(0, 6)}...${addr.slice(-4)}` : '';
            }

            formatNumber(num) {
                return Math.floor(Number(num)).toLocaleString();
            }

            setStatus(message, type = 'info') {
                const el = document.getElementById('gameStatus');
                if (el) {
                    const icons = { info: '🔗', success: '✅', warning: '⚠️', error: '❌', loading: '⏳' };
                    el.innerHTML = `${icons[type]} ${message}`;
                }
            }

            setNetwork(message, type = 'info') {
                const el = document.getElementById('networkStatus');
                if (el) {
                    const icons = { info: '🔗', success: '🟢', warning: '🟡', error: '🔴' };
                    el.innerHTML = `${icons[type]} ${message}`;
                }
            }

            setSecurity(message, type = 'info') {
                const el = document.getElementById('securityStatus');
                if (el) {
                    const icons = { info: '🛡️', success: '🟢', warning: '🟡', error: '🔴' };
                    el.innerHTML = `${icons[type]} ${message}`;
                }
            }

            // 🛡️ 显示安全提醒
            showSecurityAlert(title, message, type = 'info') {
                const modal = document.getElementById('securityModal');
                const icon = document.getElementById('securityIcon');
                const titleEl = document.getElementById('securityTitle');
                const msgEl = document.getElementById('securityMessage');
                
                const icons = { info: '🛡️', success: '✅', warning: '⚠️', error: '❌' };
                icon.textContent = icons[type];
                titleEl.textContent = title;
                msgEl.textContent = message;
                
                modal.classList.remove('hidden');
            }

            updateTokens() {
                const mao = document.getElementById('selectMao');
                const pi = document.getElementById('selectPi');
                
                if (this.state.selectedToken === 'MAO') {
                    mao?.classList.add('active');
                    pi?.classList.remove('active');
                } else {
                    mao?.classList.remove('active');
                    pi?.classList.add('active');
                }
            }

            updateUI(playing) {
                const btn = document.getElementById('spinBtn');
                const tokens = document.querySelectorAll('.token-btn');
                
                if (playing) {
                    btn.disabled = true;
                    btn.innerHTML = '<div class="loading mx-auto"></div>';
                    tokens.forEach(t => t.disabled = true);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '🛡️ 万无一失安全转盘';
                    tokens.forEach(t => t.disabled = false);
                }
            }

            // 🛡️ 更新安全状态显示
            updateSecurityStatus() {
                const { security } = this.state;
                
                document.getElementById('multisigStatus').textContent = security.multisigEnabled ? '已启用' : '未配置';
                document.getElementById('timelockStatus').textContent = security.timelockEnabled ? '已启用' : '未配置';
                document.getElementById('limitStatus').textContent = security.limitsEnabled ? '已启用' : '未配置';
                document.getElementById('monitorStatus').textContent = security.monitoringEnabled ? '已启用' : '未配置';
                
                // 计算安全等级
                let securityScore = 0;
                if (security.multisigEnabled) securityScore += 40;
                if (security.timelockEnabled) securityScore += 30;
                if (security.limitsEnabled) securityScore += 20;
                if (security.monitoringEnabled) securityScore += 10;
                
                let securityLevel = 'LOW';
                let securityColor = 'text-red-400';
                
                if (securityScore >= 80) {
                    securityLevel = 'ULTRA';
                    securityColor = 'text-purple-400';
                } else if (securityScore >= 60) {
                    securityLevel = 'HIGH';
                    securityColor = 'text-green-400';
                } else if (securityScore >= 40) {
                    securityLevel = 'MEDIUM';
                    securityColor = 'text-yellow-400';
                }
                
                const overallEl = document.getElementById('overallSecurity');
                overallEl.textContent = securityLevel;
                overallEl.className = `text-lg font-bold ${securityColor}`;
                
                security.securityLevel = securityLevel;
            }

            updateStats() {
                const { stats } = this.state;
                const els = ['totalGames', 'winCount', 'totalReward', 'winRate'];
                
                document.getElementById(els[0]).textContent = stats.totalGames;
                document.getElementById(els[1]).textContent = stats.winCount;
                document.getElementById(els[2]).textContent = this.formatNumber(stats.totalReward);
                
                const rate = stats.totalGames > 0 ? ((stats.winCount / stats.totalGames) * 100).toFixed(1) : 0;
                document.getElementById(els[3]).textContent = `${rate}%`;
            }

            startSpin() {
                document.getElementById('wheel')?.classList.add('spinning');
            }

            stopSpin() {
                document.getElementById('wheel')?.classList.remove('spinning');
            }

            showResult(result, hash) {
                this.stopSpin();
                this.state.isPlaying = false;
                this.updateUI(false);

                const modal = document.getElementById('resultModal');
                const icon = document.getElementById('resultIcon');
                const title = document.getElementById('resultTitle');
                const msg = document.getElementById('resultMessage');
                const reward = document.getElementById('resultReward');
                const tx = document.getElementById('txHash');

                if (result.isWin) {
                    icon.textContent = '🎉';
                    title.textContent = '🎊 安全区块链中奖！';
                    msg.textContent = `等级 ${result.level} - 安全奖励已发放到钱包`;
                    reward.textContent = `+${this.formatNumber(result.amount)} ${this.state.selectedToken}`;
                } else {
                    icon.textContent = '🛡️';
                    title.textContent = '安全区块链游戏';
                    msg.textContent = '这次没中奖，但交易通过了所有安全检查！';
                    reward.textContent = '继续安全游戏';
                }

                if (hash) {
                    tx.innerHTML = `<a href="https://alveyscan.com/tx/${hash}" target="_blank" class="text-blue-300">查看安全交易: ${hash.slice(0, 16)}...</a>`;
                } else {
                    tx.textContent = '';
                }

                modal.classList.remove('hidden');
                setTimeout(() => this.updateBalances(), 1000);
            }

            // 🔧 智能RPC节点测试和切换
            async testRpcNode(rpcUrl) {
                try {
                    const provider = new ethers.providers.JsonRpcProvider(rpcUrl);
                    await provider.getBlockNumber();
                    return true;
                } catch (error) {
                    console.error(`RPC节点 ${rpcUrl} 测试失败:`, error);
                    return false;
                }
            }

            async findWorkingRpcNode() {
                this.setNetwork('测试安全RPC节点连接...', 'info');
                
                for (let i = 0; i < this.rpcNodes.length; i++) {
                    const rpcUrl = this.rpcNodes[i];
                    this.setNetwork(`测试安全节点 ${i + 1}/${this.rpcNodes.length}: ${rpcUrl}`, 'info');
                    
                    const isWorking = await this.testRpcNode(rpcUrl);
                    if (isWorking) {
                        this.state.currentRpcIndex = i;
                        this.setNetwork(`🟢 安全连接成功: ${rpcUrl}`, 'success');
                        return rpcUrl;
                    }
                }
                
                throw new Error('所有安全RPC节点都无法连接');
            }

            async setupNetwork() {
                try {
                    this.setNetwork('初始化多节点安全AlveyChain...', 'info');
                    
                    if (!window.ethereum) {
                        throw new Error('请安装 MetaMask 才能进行安全区块链游戏');
                    }

                    // 🔧 找到可用的安全RPC节点
                    const workingRpc = await this.findWorkingRpcNode();

                    const chainId = await window.ethereum.request({ method: 'eth_chainId' });
                    const target = '0xED5'; // AlveyChain 3797
                    
                    if (chainId !== target) {
                        this.setNetwork('切换到 AlveyChain 安全主网...', 'warning');
                        
                        try {
                            await window.ethereum.request({
                                method: 'wallet_switchEthereumChain',
                                params: [{ chainId: target }]
                            });
                        } catch (switchError) {
                            if (switchError.code === 4902) {
                                // 使用可用的安全RPC节点添加网络
                                await window.ethereum.request({
                                    method: 'wallet_addEthereumChain',
                                    params: [{
                                        chainId: target,
                                        chainName: 'AlveyChain Mainnet',
                                        nativeCurrency: { name: 'ALV', symbol: 'ALV', decimals: 18 },
                                        rpcUrls: [workingRpc], // 使用可用的安全RPC
                                        blockExplorerUrls: ['https://alveyscan.com']
                                    }]
                                });
                            }
                        }
                    }

                    // 再次测试安全连接
                    const provider = new ethers.providers.Web3Provider(window.ethereum);
                    await provider.getBlockNumber();

                    this.setNetwork(`🟢 安全AlveyChain多节点系统已连接 (使用节点${this.state.currentRpcIndex + 1})`, 'success');
                    return true;

                } catch (error) {
                    console.error('安全网络设置失败:', error);
                    this.setNetwork(`❌ 安全网络错误: ${error.message}`, 'error');
                    return false;
                }
            }

            // 🛡️ 安全钱包连接
            async connectWallet() {
                try {
                    const networkOk = await this.setupNetwork();
                    if (!networkOk) {
                        this.setStatus('请先正确连接AlveyChain安全网络', 'error');
                        return;
                    }

                    this.setStatus('连接安全区块链钱包...', 'loading');
                    this.setSecurity('验证钱包安全性...', 'info');

                    const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                    if (!accounts.length) {
                        this.setStatus('请授权安全钱包连接', 'warning');
                        return;
                    }

                    // 🔐 安全检查用户钱包地址
                    if (!this.isAddressSafe(accounts[0])) {
                        this.setStatus('钱包地址安全检查失败', 'error');
                        return;
                    }

                    this.state.wallet = {
                        address: accounts[0],
                        provider: new ethers.providers.Web3Provider(window.ethereum),
                        connected: true
                    };
                    this.state.wallet.signer = this.state.wallet.provider.getSigner();

                    // 初始化安全智能合约
                    this.setStatus('初始化安全智能合约...', 'loading');
                    this.setSecurity('验证合约地址安全性...', 'info');
                    
                    // 🔐 检查所有合约地址安全性
                    const contractAddresses = [
                        this.secureAddresses.MAO_TOKEN,
                        this.secureAddresses.PI_TOKEN,
                        this.secureAddresses.WHEEL_GAME
                    ];
                    
                    for (const addr of contractAddresses) {
                        if (!this.isAddressSafe(addr)) {
                            throw new Error(`合约地址 ${addr} 安全检查失败`);
                        }
                    }
                    
                    this.state.contracts.mao = new ethers.Contract(this.secureAddresses.MAO_TOKEN, this.tokenABI, this.state.wallet.signer);
                    this.state.contracts.pi = new ethers.Contract(this.secureAddresses.PI_TOKEN, this.tokenABI, this.state.wallet.signer);
                    this.state.contracts.wheelGame = new ethers.Contract(this.secureAddresses.WHEEL_GAME, this.gameABI, this.state.wallet.signer);

                    // 验证安全合约连接
                    await Promise.all([
                        this.state.contracts.mao.symbol(),
                        this.state.contracts.pi.symbol(),
                        this.state.contracts.wheelGame.getPlayerHistory(this.state.wallet.address)
                    ]);

                    this.updateWallet();
                    await this.updateBalances();
                    await this.loadStats();
                    await this.checkSecurityConfig();
                    
                    this.setStatus('🛡️ 安全多节点区块链系统已完全连接', 'success');
                    this.setSecurity('🛡️ 安全系统已激活', 'success');

                } catch (error) {
                    console.error('安全钱包连接失败:', error);
                    this.setStatus(`安全连接失败: ${error.message}`, 'error');
                    this.setSecurity('❌ 安全系统连接失败', 'error');
                }
            }

            // 🔐 检查安全配置
            async checkSecurityConfig() {
                this.setSecurity('检查安全配置...', 'info');
                
                try {
                    // 检查多重签名钱包
                    if (this.secureAddresses.MULTISIG_WALLET && this.secureAddresses.MULTISIG_WALLET !== "0x0000000000000000000000000000000000000000") {
                        this.state.contracts.multisig = new ethers.Contract(this.secureAddresses.MULTISIG_WALLET, this.multisigABI, this.state.wallet.signer);
                        try {
                            await this.state.contracts.multisig.getThreshold();
                            this.state.security.multisigEnabled = true;
                        } catch (e) {
                            console.log('多重签名钱包未配置或不可用');
                        }
                    }
                    
                    // 检查时间锁
                    if (this.secureAddresses.TIMELOCK_CONTROLLER && this.secureAddresses.TIMELOCK_CONTROLLER !== "0x0000000000000000000000000000000000000000") {
                        this.state.contracts.timelock = new ethers.Contract(this.secureAddresses.TIMELOCK_CONTROLLER, this.timelockABI, this.state.wallet.signer);
                        try {
                            await this.state.contracts.timelock.getMinDelay();
                            this.state.security.timelockEnabled = true;
                        } catch (e) {
                            console.log('时间锁控制器未配置或不可用');
                        }
                    }
                    
                    // 更新安全状态
                    this.updateSecurityStatus();
                    
                    if (this.state.security.securityLevel === 'LOW') {
                        this.showSecurityAlert(
                            '⚠️ 安全等级较低',
                            '建议配置多重签名和时间锁以提高安全性',
                            'warning'
                        );
                    }
                    
                } catch (error) {
                    console.error('安全配置检查失败:', error);
                    this.setSecurity('⚠️ 安全配置检查部分失败', 'warning');
                }
            }

            updateWallet() {
                const disc = document.getElementById('walletDisconnected');
                const conn = document.getElementById('walletConnected');
                
                if (this.state.wallet.connected) {
                    disc?.classList.add('hidden');
                    conn?.classList.remove('hidden');
                    document.getElementById('walletAddress').textContent = this.formatAddress(this.state.wallet.address);
                } else {
                    disc?.classList.remove('hidden');
                    conn?.classList.add('hidden');
                }
            }

            async updateBalances() {
                if (!this.state.wallet.connected) return;

                try {
                    const [maoBalance, piBalance] = await Promise.all([
                        this.state.contracts.mao.balanceOf(this.state.wallet.address),
                        this.state.contracts.pi.balanceOf(this.state.wallet.address)
                    ]);

                    document.getElementById('maoBalance').textContent = this.formatNumber(ethers.utils.formatEther(maoBalance));
                    document.getElementById('piBalance').textContent = this.formatNumber(ethers.utils.formatEther(piBalance));
                } catch (error) {
                    console.error('更新余额失败:', error);
                    this.setStatus('余额查询失败，尝试切换安全RPC节点', 'warning');
                }
            }

            async loadStats() {
                if (!this.state.contracts.wheelGame) return;

                try {
                    const history = await this.state.contracts.wheelGame.getPlayerHistory(this.state.wallet.address);

                    let totalGames = 0;
                    let winCount = 0;
                    let totalReward = 0;

                    history.forEach(game => {
                        totalGames++;
                        if (game.rewardAmount.gt(0)) {
                            winCount++;
                            totalReward += parseFloat(ethers.utils.formatEther(game.rewardAmount));
                        }
                    });

                    this.state.stats = { totalGames, winCount, totalReward };
                    this.updateStats();

                } catch (error) {
                    console.error('加载统计失败:', error);
                }
            }

            // 🔧 安全智能合约调用重试机制
            async executeContractCall(contractCall, retries = 3) {
                for (let attempt = 1; attempt <= retries; attempt++) {
                    try {
                        this.setStatus(`执行安全区块链交易 (尝试 ${attempt}/${retries})...`, 'loading');
                        return await contractCall();
                    } catch (error) {
                        console.error(`安全交易尝试 ${attempt} 失败:`, error);
                        
                        if (attempt < retries) {
                            // 如果失败，尝试切换安全RPC节点
                            this.setStatus(`安全交易失败，切换RPC节点重试...`, 'warning');
                            
                            this.state.currentRpcIndex = (this.state.currentRpcIndex + 1) % this.rpcNodes.length;
                            const newRpc = this.rpcNodes[this.state.currentRpcIndex];
                            this.setNetwork(`切换到安全节点: ${newRpc}`, 'warning');
                            
                            // 等待1秒后重试
                            await new Promise(resolve => setTimeout(resolve, 1000));
                        } else {
                            throw error;
                        }
                    }
                }
            }

            // 🛡️ 安全区块链游戏
            async startSecureBlockchainGame() {
                if (!this.state.wallet.connected) {
                    this.setStatus('请先连接安全钱包进行区块链游戏', 'warning');
                    return;
                }

                if (this.state.isPlaying) return;

                // 🔐 安全等级检查
                if (this.state.security.securityLevel === 'LOW') {
                    this.showSecurityAlert(
                        '⚠️ 安全等级较低',
                        '当前安全等级较低，建议先配置多重签名和时间锁再进行游戏',
                        'warning'
                    );
                    // 仍然允许游戏，但给出警告
                }

                try {
                    this.state.isPlaying = true;
                    this.updateUI(true);

                    const { selectedToken } = this.state;
                    const tokenContract = selectedToken === 'MAO' ? this.state.contracts.mao : this.state.contracts.pi;
                    const amount = ethers.utils.parseEther(selectedToken === 'MAO' ? '100' : '1000');
                    
                    // 🔐 安全余额检查
                    this.setStatus('检查安全代币余额...', 'loading');
                    const balance = await tokenContract.balanceOf(this.state.wallet.address);
                    if (balance.lt(amount)) {
                        throw new Error(`安全余额不足！需要 ${selectedToken === 'MAO' ? '100' : '1000'} ${selectedToken} 代币`);
                    }

                    // 🔐 安全授权检查
                    this.setStatus('检查智能合约安全授权...', 'loading');
                    const allowance = await tokenContract.allowance(this.state.wallet.address, this.secureAddresses.WHEEL_GAME);
                    if (allowance.lt(amount)) {
                        this.setStatus('授权智能合约安全访问代币...', 'loading');
                        
                        const approveTx = await this.executeContractCall(async () => {
                            return await tokenContract.approve(this.secureAddresses.WHEEL_GAME, ethers.constants.MaxUint256);
                        });
                        
                        this.setStatus('等待安全授权交易确认...', 'loading');
                        await approveTx.wait(this.securityLimits.requiredConfirmations);
                        this.setStatus('安全授权成功，准备游戏', 'success');
                    }

                    this.setStatus('启动万无一失安全区块链转盘...', 'loading');
                    this.startSpin();
                    
                    // 🛡️ 多重保护的安全区块链调用
                    const gasOptions = {
                        gasLimit: selectedToken === 'MAO' ? 1000000 : 1200000, // 增加Gas限制
                        gasPrice: ethers.utils.parseUnits('25', 'gwei').lt(this.securityLimits.maxGasPrice) ? 
                                  ethers.utils.parseUnits('25', 'gwei') : this.securityLimits.maxGasPrice // 安全Gas价格限制
                    };
                    
                    const gameTx = await this.executeContractCall(async () => {
                        if (selectedToken === 'MAO') {
                            return await this.state.contracts.wheelGame.playMAOGame(gasOptions);
                        } else {
                            return await this.state.contracts.wheelGame.playPIGame(gasOptions);
                        }
                    });

                    this.setStatus('安全区块链挖矿确认中...请等待', 'loading');
                    const receipt = await gameTx.wait(this.securityLimits.requiredConfirmations); // 等待更多确认提高安全性

                    // 🛡️ 安全结果解析 - 多重机制确保成功
                    let result = null;
                    
                    // 方法1：事件解析
                    try {
                        if (receipt.events && receipt.events.length > 0) {
                            const gameEvent = receipt.events.find(e => e.event === 'GamePlayed');
                            if (gameEvent && gameEvent.args) {
                                const { rewardAmount, rewardLevel } = gameEvent.args;
                                result = {
                                    isWin: rewardAmount.gt(0),
                                    amount: ethers.utils.formatEther(rewardAmount),
                                    level: rewardLevel.toString()
                                };
                            }
                        }
                    } catch (eventError) {
                        console.log('事件解析失败，尝试其他安全方法');
                    }
                    
                    // 方法2：安全日志解析
                    if (!result && receipt.logs && receipt.logs.length > 0) {
                        try {
                            for (const log of receipt.logs) {
                                try {
                                    const parsedLog = this.state.contracts.wheelGame.interface.parseLog(log);
                                    if (parsedLog.name === 'GamePlayed') {
                                        const { rewardAmount, rewardLevel } = parsedLog.args;
                                        result = {
                                            isWin: rewardAmount.gt(0),
                                            amount: ethers.utils.formatEther(rewardAmount),
                                            level: rewardLevel.toString()
                                        };
                                        break;
                                    }
                                } catch (parseError) {
                                    continue;
                                }
                            }
                        } catch (logError) {
                            console.log('日志解析失败，尝试安全历史查询');
                        }
                    }
                    
                    // 方法3：安全历史查询
                    if (!result) {
                        try {
                            this.setStatus('查询安全游戏记录...', 'loading');
                            await new Promise(resolve => setTimeout(resolve, 3000)); // 等待3秒让区块链更新
                            
                            const newHistory = await this.state.contracts.wheelGame.getPlayerHistory(this.state.wallet.address);
                            if (newHistory.length > 0) {
                                const lastGame = newHistory[newHistory.length - 1];
                                const timeDiff = Date.now() / 1000 - lastGame.timestamp.toNumber();
                                if (timeDiff < 600) { // 10分钟内的游戏
                                    result = {
                                        isWin: lastGame.rewardAmount.gt(0),
                                        amount: ethers.utils.formatEther(lastGame.rewardAmount),
                                        level: lastGame.rewardLevel.toString()
                                    };
                                }
                            }
                        } catch (historyError) {
                            console.error('安全历史查询失败:', historyError);
                        }
                    }
                    
                    // 如果仍然无法解析结果，这是安全的区块链错误
                    if (!result) {
                        throw new Error('无法解析安全区块链游戏结果，交易可能仍在处理中，请稍后查看钱包余额变化');
                    }

                    // 显示安全结果
                    setTimeout(() => {
                        this.showResult(result, gameTx.hash);
                        this.loadStats(); // 重新加载安全统计
                    }, 2000);

                } catch (error) {
                    console.error('安全区块链游戏错误:', error);
                    
                    let errorMsg = error.message;
                    if (errorMsg.includes('insufficient funds')) {
                        errorMsg = '余额不足，请充值足够的代币和ALV';
                    } else if (errorMsg.includes('user rejected')) {
                        errorMsg = '用户取消了交易';
                    } else if (errorMsg.includes('gas')) {
                        errorMsg = 'Gas费用不足，请增加Gas费用';
                    } else if (errorMsg.includes('network') || errorMsg.includes('RPC')) {
                        errorMsg = '安全RPC网络连接问题，已自动尝试多个节点';
                    } else if (errorMsg.includes('CALL_EXCEPTION')) {
                        errorMsg = '智能合约调用失败，可能是网络拥堵，请稍后重试';
                    }

                    this.setStatus(`安全游戏错误: ${errorMsg}`, 'error');
                    this.stopSpin();
                    this.state.isPlaying = false;
                    this.updateUI(false);
                }
            }

            // 🔐 安全控制功能
            async initializeMultisig() {
                this.showSecurityAlert(
                    '🔐 多重签名初始化',
                    '多重签名钱包配置需要专业部署，请联系技术团队进行安全配置',
                    'info'
                );
            }

            async setupTimelock() {
                this.showSecurityAlert(
                    '⏰ 时间锁配置',
                    '时间锁控制器配置需要专业部署，可设置24-72小时延迟保护',
                    'info'
                );
            }

            async setLimits() {
                this.showSecurityAlert(
                    '💰 限额控制设置',
                    '当前限额：单次10,000代币，每日50,000代币，每周200,000代币',
                    'info'
                );
            }

            async enableMonitoring() {
                this.showSecurityAlert(
                    '📊 实时监控启用',
                    '实时监控系统可检测异常交易并自动预警，建议启用24/7监控',
                    'info'
                );
            }

            init() {
                document.addEventListener('DOMContentLoaded', () => {
                    this.setupEvents();
                    this.updateTokens();
                    this.updateStats();
                    this.updateSecurityStatus();
                    this.setupNetwork();
                });

                if (window.ethereum) {
                    window.ethereum.on('accountsChanged', (accounts) => {
                        if (accounts.length === 0) {
                            this.state.wallet.connected = false;
                            this.updateWallet();
                            this.setStatus('安全钱包已断开', 'warning');
                        } else {
                            this.connectWallet();
                        }
                    });

                    window.ethereum.on('chainChanged', () => {
                        this.setStatus('网络已切换，重新连接安全系统...', 'info');
                        setTimeout(() => window.location.reload(), 1000);
                    });
                }
            }

            setupEvents() {
                document.getElementById('connectBtn')?.addEventListener('click', () => this.connectWallet());

                document.getElementById('selectMao')?.addEventListener('click', () => {
                    this.state.selectedToken = 'MAO';
                    this.updateTokens();
                    this.setStatus('MAO 安全代币模式', 'info');
                });
                
                document.getElementById('selectPi')?.addEventListener('click', () => {
                    this.state.selectedToken = 'PI';
                    this.updateTokens();
                    this.setStatus('PI 安全代币模式', 'info');
                });

                document.getElementById('spinBtn')?.addEventListener('click', () => this.startSecureBlockchainGame());

                document.getElementById('closeModal')?.addEventListener('click', () => {
                    document.getElementById('resultModal')?.classList.add('hidden');
                });

                document.getElementById('closeSecurityModal')?.addEventListener('click', () => {
                    document.getElementById('securityModal')?.classList.add('hidden');
                });

                // 🛡️ 安全控制事件
                document.getElementById('initMultisigBtn')?.addEventListener('click', () => this.initializeMultisig());
                document.getElementById('setupTimelockBtn')?.addEventListener('click', () => this.setupTimelock());
                document.getElementById('setLimitsBtn')?.addEventListener('click', () => this.setLimits());
                document.getElementById('enableMonitorBtn')?.addEventListener('click', () => this.enableMonitoring());
            }
        }

        // 🛡️ 启动万无一失安全区块链游戏引擎 v9.0 ULTRA-SECURE
        const ultraSecureGame = new UltraSecureBlockchainGameEngine();
        console.log('🛡️ 万无一失安全系统已启动');
    </script>
</body>
</html> 